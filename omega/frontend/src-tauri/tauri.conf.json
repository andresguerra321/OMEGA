{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMEGA Security",
  "version": "2.0.7",
  "identifier": "com.omega.security.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run stage:resources && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OMEGA Security",
        "width": 1340,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https: http://127.0.0.1:* http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/omega-sensor"],
    "resources": {
      "bundle-resources/omega/": "omega/"
    },
    "windows": {
      "wix": {
        "language": "es-ES"
      },
      "nsis": {
        "installMode": "currentUser",
        "compression": "zlib"
      }
    }
  }
}
