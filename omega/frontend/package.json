{
  "name": "omega-desktop",
  "private": true,
  "version": "1.7.0",
  "productName": "OMEGA",
  "description": "OMEGA — Plataforma Defensiva de Cyber Threat Intelligence",
  "author": "OMEGA",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "test:desktop": "node --test electron/dockerOrchestrator.test.js src/lib/validators.test.js src/lib/api.test.js",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --port 5174 --strictPort\" \"wait-on http://localhost:5174 && node electron/launch.js http://localhost:5174\"",
    "desktop:start": "vite build && node electron/launch.js",
    "desktop:pack": "vite build && electron-builder --dir",
    "desktop:dist": "vite build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.omega.desktop",
    "productName": "OMEGA",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.test.js",
      "!electron/**/*.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      },
      {
        "from": "..",
        "to": "omega",
        "filter": [
          "docker-compose.yml",
          "docker-compose.prod.yml",
          ".env.example",
          "db/init.sql",
          "corpus_mvp/iocs/**/*",
          "api/**/*",
          "backend-java/**/*",
          "!**/.env",
          "!**/.env.local",
          "!**/.env.production",
          "!**/.env.development",
          "!.env",
          "!**/.venv/**",
          "!**/venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/target/**",
          "!**/node_modules/**",
          "!**/tests/**",
          "!**/.git/**"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OMEGA",
      "artifactName": "OMEGA-Setup-${version}-${arch}.exe"
    },
    "portable": {
      "artifactName": "OMEGA-Portable-${version}-${arch}.exe"
    }
  }
}
