# ==============================================================================
# OMEGA — Variables de Entorno Backend (Arquitectura Zero-Retention Java + Worker)
# ==============================================================================

# PostgreSQL 16 + pgvector (red privada interna sin exposición pública)
POSTGRES_USER=omega_admin
POSTGRES_PASSWORD=reemplazar_password_postgres_seguro
POSTGRES_DB=omega_cti
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# API Principal Spring Boot (Java 21)
JAVA_BACKEND_PORT=8080

# JWT Multi-Tenant (CRÍTICO: mínimo 32 caracteres aleatorios en producción)
OMEGA_JWT_SECRET=reemplazar_por_secreto_criptografico_minimo_32_bytes_en_produccion
OMEGA_JWT_EXPIRATION_SECONDS=3600
OMEGA_ALLOW_TENANT_SELF_REGISTRATION=false
OMEGA_BOOTSTRAP_SECRET=reemplazar_por_secreto_bootstrap_admin

# Autenticación mutua entre backend-java y el worker forense stateless (X-Internal-Service-Token)
INTERNAL_SERVICE_TOKEN=reemplazar_por_token_interno_aleatorio_minimo_32_bytes

# Embeddings e Inferencia RAG (Interfaz desacoplada EmbeddingProvider)
OPENAI_API_KEY=tu_clave_de_openai_aqui
OPENAI_BASE_URL=https://api.openai.com/v1
OMEGA_EMBEDDING_PROVIDER=openai
OMEGA_EMBEDDING_MODEL=text-embedding-3-small
OMEGA_EMBEDDING_DIMENSIONS=1536
OMEGA_CHAT_MODEL=gpt-4o-mini

# Límites de Ingesta Zero-Retention y Feeds STIX 2.1
OMEGA_INGEST_TMP_DIR=/tmp/omega_ingest
OMEGA_MAX_PDF_BYTES=26214400
OMEGA_STIX_CORPUS_DIR=/app/corpus_mvp/iocs
TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata
