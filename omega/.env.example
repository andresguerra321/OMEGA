# ==============================================================================
# OMEGA — Variables de Entorno Backend (Arquitectura Zero-Retention Java + Worker)
# ==============================================================================

# PostgreSQL 16 + pgvector (red privada interna sin exposición pública)
POSTGRES_USER=omega_admin
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=omega_cti
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# API Principal Spring Boot (Java 21)
JAVA_BACKEND_PORT=8080

# JWT Multi-Tenant (CRÍTICO: mínimo 32 caracteres aleatorios en producción)
OMEGA_JWT_SECRET=CHANGEME
OMEGA_JWT_EXPIRATION_SECONDS=3600
OMEGA_COOKIE_SECURE=false
OMEGA_ALLOW_TENANT_SELF_REGISTRATION=false
OMEGA_BOOTSTRAP_SECRET=CHANGEME

# Autenticación mutua entre backend-java y el worker forense stateless (X-Internal-Service-Token)
INTERNAL_SERVICE_TOKEN=CHANGEME

# Embeddings e Inferencia RAG (Interfaz desacoplada EmbeddingProvider)
OPENAI_API_KEY=tu_clave_de_openai_aqui
OPENAI_BASE_URL=https://api.openai.com/v1
OMEGA_EMBEDDING_PROVIDER=openai
OMEGA_EMBEDDING_MODEL=text-embedding-3-small
OMEGA_EMBEDDING_DIMENSIONS=1536
OMEGA_CHAT_MODEL=gpt-4o-mini

# Groq (respaldo o proveedor primario ultrarrápido si OPENAI_API_KEY está vacío)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OmniRoute (opcional: router multi-proveedor / fallback automático con dashboard en http://127.0.0.1:20128/dashboard)
# Para activar el contenedor incluido en docker-compose.yml:
# COMPOSE_PROFILES=omniroute
# OMNIROUTE_BASE_URL=http://omniroute:20128/v1
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
OMNIROUTE_PORT=20128

# Proveedor / Endpoint personal de chat (Ollama local, Gemini OpenAI-compat, OpenRouter, LM Studio o servidor /v1)
# No interfiere con OPENAI_BASE_URL de embeddings; si se define, tiene prioridad #1 para respuestas RAG
# Ejemplo Ollama local: CUSTOM_LLM_PROVIDER=ollama | CUSTOM_LLM_BASE_URL=http://host.docker.internal:11434/v1 | CUSTOM_LLM_MODEL=llama3.2
CUSTOM_LLM_PROVIDER=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Límites de Ingesta Zero-Retention y Feeds STIX 2.1
OMEGA_INGEST_TMP_DIR=/tmp/omega_ingest
OMEGA_MAX_PDF_BYTES=26214400
OMEGA_STIX_CORPUS_DIR=/app/corpus_mvp/iocs
TESSDATA_PREFIX=/usr/share/tesseract-ocr/4.00/tessdata

# OSINT — Have I Been Pwned API v3 (opcional; requiere clave de pago en haveibeenpwned.com/API/Key)
HIBP_API_KEY=

# Feeds externos de IOCs (OpenPhish es gratuito sin clave; URLhaus/ThreatFox requieren Auth-Key gratuita de auth.abuse.ch)
OMEGA_EXTERNAL_IOC_SYNC_ENABLED=true
ABUSECH_AUTH_KEY=
# Reputación bajo demanda opcional (niveles gratuitos con cuota)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Almacenamiento de objetos S3-compatible (MinIO) — por defecto modo Zero-Retention (noop)
# provider: noop | minio
OMEGA_STORAGE_PROVIDER=noop
OMEGA_STORAGE_RETENTION_ENABLED=false
OMEGA_STORAGE_RETENTION_DAYS=365
OMEGA_MINIO_ENDPOINT=http://localhost:9000
OMEGA_MINIO_ACCESS_KEY=CHANGEME
OMEGA_MINIO_SECRET_KEY=CHANGEME
OMEGA_MINIO_VAULT_BUCKET=omega-vault
OMEGA_MINIO_STAGING_BUCKET=omega-staging
OMEGA_MINIO_PRESIGN_TTL_SECONDS=90
# Facturación: desactivada hasta configurar un backend público de pruebas.
OMEGA_MP_MODE=disabled
# Membresías y créditos siempre se aplican; desactivar pagos no concede acceso Pro.
# Se conserva esta variable por compatibilidad; false tampoco omite los controles.
OMEGA_BILLING_ENFORCE=true
OMEGA_MP_ACCESS_TOKEN=
OMEGA_MP_SELLER_ID=
OMEGA_MP_WEBHOOK_SECRET=
OMEGA_MP_TEST_PAYER_EMAIL=
OMEGA_PUBLIC_BASE_URL=
OMEGA_BILLING_RETURN_URL=
# GitHub App en web. El origen HTTPS sirve el frontend de OMEGA.
OMEGA_GITHUB_PUBLIC_ORIGIN=
OMEGA_GITHUB_APP_SLUG=
OMEGA_GITHUB_APP_CLIENT_ID=
OMEGA_GITHUB_APP_CLIENT_SECRET=
OMEGA_GITHUB_APP_ID=
OMEGA_GITHUB_APP_PRIVATE_KEY=
OMEGA_GITHUB_WEBHOOK_SECRET=
OMEGA_GITHUB_APP_BOT_LOGIN=
# Google OIDC. Usa localhost para pruebas o el origen HTTPS web de OMEGA.
OMEGA_GOOGLE_PUBLIC_ORIGIN=
OMEGA_GOOGLE_CLIENT_ID=
OMEGA_GOOGLE_CLIENT_SECRET=
# SELF_HOSTED solo cuando el backend y Ollama se ejecutan en infraestructura del cliente.
OMEGA_DEPLOYMENT_MODE=CLOUD_MANAGED

# Comercial: datos del prestador persona natural. No confundir CC con NIT/RUT.
OMEGA_SELLER_LEGAL_NAME=
OMEGA_SELLER_NIT=
OMEGA_SELLER_ADDRESS=
OMEGA_SUPPORT_EMAIL=
OMEGA_PRIVACY_EMAIL=
# Publicar exige identidad completa y terms.txt/privacy.txt revisados en un directorio accesible al backend.
OMEGA_COMMERCIAL_DOCUMENTS_PUBLISHED=false
OMEGA_COMMERCIAL_DOCUMENTS_DIR=
# Activar solo tras verificar destinatarios y SMTP. Para QA usar Mailpit u otro buzón aislado.
OMEGA_TRANSACTIONAL_MAIL_ENABLED=false
