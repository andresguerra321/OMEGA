# Configuración PostgreSQL con pgvector
POSTGRES_USER=omega_admin
POSTGRES_PASSWORD=omega_dev_secret
POSTGRES_DB=omega_cti
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Seguridad y JWT del núcleo Java / Spring Boot (CRÍTICO: usar secreto aleatorio de >= 32 bytes en producción)
JAVA_BACKEND_PORT=8080
OMEGA_JWT_SECRET=reemplazar_por_secreto_criptografico_minimo_32_bytes_en_produccion
OMEGA_JWT_EXPIRATION_SECONDS=3600
OMEGA_ALLOW_TENANT_SELF_REGISTRATION=false
OMEGA_BOOTSTRAP_SECRET=

# Embeddings e Inferencia RAG (MVP OpenAI + Groq)
OPENAI_API_KEY=tu_clave_de_openai_aqui
OMEGA_EMBEDDING_MODEL=text-embedding-3-small
GROQ_API_KEY=tu_clave_de_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b
